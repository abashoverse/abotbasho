# Must serve eth_getLogs (Alchemy, Infura, own node). Comma-separate to
# round-robin across several getLogs-capable providers (not dRPC free).
PONDER_RPC_URL_1=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Lower than Ponder's default 50 to avoid 429s on free RPC tiers (~10 for Alchemy free).
#PONDER_MAX_RPS=10
PONDER_PORT=42069
